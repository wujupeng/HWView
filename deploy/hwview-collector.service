[Unit]
Description=HWView Collector - Incremental Data Collector
After=network.target hwview-server.service
Wants=network.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/opt/hwview
ExecStart=/opt/hwview/bin/hwview-collector
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

Environment=HWVIEW_CONFIG=/opt/hwview/config/config.yaml

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hwview-collector

[Install]
WantedBy=multi-user.target